# SyncSphere API environment configuration.
# Copy to server/.env for local development. Never commit real credentials.
# The application loads .env through --env-file-if-exists in npm scripts.
# Integration tests do not load .env; set database variables in the shell.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Comma-separated explicit origins. Required in production. Wildcards rejected.
CORS_ORIGIN=http://localhost:4200

# false, or an integer hop count (1-10) when behind a trusted proxy.
TRUST_PROXY=false

# Versioned API rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# express.json / express.urlencoded body size limit.
BODY_LIMIT=1mb

# Graceful shutdown timeout in milliseconds (1000-60000).
SHUTDOWN_TIMEOUT_MS=10000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication secrets
# Required. Use independent random values of at least 32 characters.
# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-random-access-token-secret-at-least-32-characters
AUTH_CSRF_SECRET=replace-with-a-different-random-csrf-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_ISSUER=syncsphere-api
AUTH_ACCESS_TOKEN_AUDIENCE=syncsphere-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_ACCESS_TOKEN_CLOCK_TOLERANCE_SECONDS=5
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Refresh and CSRF cookies
# Defaults are shown commented. Production requires Secure cookies.
# ---------------------------------------------------------------------------
# AUTH_REFRESH_COOKIE_NAME=syncsphere_refresh
# AUTH_CSRF_COOKIE_NAME=syncsphere_csrf
# Keep the HttpOnly refresh cookie scoped to auth endpoints.
# AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# The CSRF cookie is readable by the SPA so it can restore sessions.
# AUTH_CSRF_COOKIE_PATH=/
# AUTH_REFRESH_COOKIE_DOMAIN=
# strict | lax | none. "none" requires Secure cookies.
# AUTH_REFRESH_COOKIE_SAME_SITE=strict
# Local development may use false. Production must use true.
# AUTH_REFRESH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Argon2id password policy and hashing cost
# ---------------------------------------------------------------------------
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Authentication endpoint rate limits (shared window)
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REFRESH_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# One-time administrator provisioning
# Used only by: npm run provision:admin
# Prefer passing these in the shell instead of storing them in .env.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_FULL_NAME=Platform Administrator
# ADMIN_PASSWORD=replace-with-a-policy-compliant-password
# ADMIN_PROVISION_CONFIRM=YES

# ---------------------------------------------------------------------------
# Database startup policy and shared timeout
# required: all three databases must be configured and connect at startup.
# optional: missing or unavailable databases do not block startup.
# Production must use required.
# ---------------------------------------------------------------------------
DATABASE_STARTUP_POLICY=optional
DATABASE_CONNECT_TIMEOUT=10000

# ---------------------------------------------------------------------------
# MySQL
# Values match infrastructure/docker-compose.yml. Replace the password with
# MYSQL_PASSWORD from infrastructure/.env. Uncomment to enable the dependency.
# ---------------------------------------------------------------------------
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=syncsphere
# MYSQL_PASSWORD=replace-with-mysql-password
# MYSQL_DATABASE=syncsphere
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_CONNECT_TIMEOUT=10000
# MYSQL_SSL=false

# ---------------------------------------------------------------------------
# MongoDB
# Use the application user created by infrastructure/mongodb/init.
# Replace the password with MONGODB_APP_PASSWORD from infrastructure/.env.
# Uncomment both URI and database to enable the dependency.
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb://syncsphere:replace-with-mongodb-app-password@127.0.0.1:27017/syncsphere?authSource=syncsphere
# MONGODB_DATABASE=syncsphere
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_SERVER_SELECTION_TIMEOUT=10000

# ---------------------------------------------------------------------------
# Redis
# Replace the password with REDIS_PASSWORD from infrastructure/.env.
# Uncomment REDIS_URL to enable the dependency.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379
# REDIS_CONNECT_TIMEOUT=10000
# REDIS_MAX_RETRIES=5
