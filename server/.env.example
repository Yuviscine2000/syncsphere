# SyncSphere API environment configuration.
# Copy to .env for local development. Never commit real credentials.

NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:4200

# Deliberate proxy trust: false, or an integer hop count (1-10).
TRUST_PROXY=false

# Rate limiting (applied to the versioned API).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Request body size limit accepted by express.json / express.urlencoded.
BODY_LIMIT=1mb

# Graceful shutdown timeout in milliseconds (1000-60000).
SHUTDOWN_TIMEOUT_MS=10000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Authentication. Replace every placeholder before running outside tests.
# Use independent, randomly generated values of at least 32 characters.
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-random-32-character-access-token-secret
AUTH_CSRF_SECRET=replace-with-a-different-random-32-character-csrf-secret
AUTH_ACCESS_TOKEN_ISSUER=syncsphere-api
AUTH_ACCESS_TOKEN_AUDIENCE=syncsphere-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_ACCESS_TOKEN_CLOCK_TOLERANCE_SECONDS=5
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Refresh cookie and CSRF cookie settings.
# AUTH_REFRESH_COOKIE_NAME=syncsphere_refresh
# AUTH_CSRF_COOKIE_NAME=syncsphere_csrf
# Keep the HttpOnly refresh cookie scoped to auth endpoints.
# AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# The readable CSRF cookie must be visible to the SPA so startup can restore
# a session after sessionStorage is cleared. Keep this at "/" unless the SPA
# is served from a narrower path. Auth responses also clear legacy CSRF
# cookies left at the refresh path during migration.
# AUTH_CSRF_COOKIE_PATH=/
# AUTH_REFRESH_COOKIE_DOMAIN=
# strict | lax | none. "none" requires Secure cookies.
# AUTH_REFRESH_COOKIE_SAME_SITE=strict
# AUTH_REFRESH_COOKIE_SECURE=false

# Argon2id password policy and hashing cost.
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Auth endpoint rate limits (shared window).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REFRESH_RATE_LIMIT_MAX=60

# One-time administrator provisioning (used only with scripts/provision-admin.js).
# ADMIN_EMAIL=admin@example.com
# ADMIN_FULL_NAME=Platform Administrator
# ADMIN_PASSWORD=replace-with-a-policy-compliant-password
# ADMIN_PROVISION_CONFIRM=YES

# Database startup policy: required or optional.
# Production requires "required"; non-production defaults to "optional".
DATABASE_STARTUP_POLICY=optional

# Shared default connection timeout in milliseconds (1000-60000).
DATABASE_CONNECT_TIMEOUT=10000

# MySQL. Uncomment the core values to enable the dependency.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=syncsphere
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=syncsphere
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_CONNECT_TIMEOUT=10000
# MYSQL_SSL=false

# MongoDB. Uncomment both values to enable the dependency.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=syncsphere
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_SERVER_SELECTION_TIMEOUT=10000

# Redis. Uncomment REDIS_URL to enable the dependency.
# REDIS_URL=redis://localhost:6379
# REDIS_CONNECT_TIMEOUT=10000
# REDIS_MAX_RETRIES=5
