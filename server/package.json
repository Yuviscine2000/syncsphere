{
  "name": "@syncsphere/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SyncSphere REST API foundation",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "provision:admin": "node --env-file-if-exists=.env scripts/provision-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "cookie": "2.0.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jose": "6.2.16",
    "mongodb": "7.8.0",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
