# SyncSphere local infrastructure configuration.
# Copy this file to infrastructure/.env and replace every placeholder.
# Never commit real credentials.
# These values are consumed by Docker Compose. Configure the matching
# database values in server/.env for the application.

COMPOSE_PROJECT_NAME=syncsphere
TZ=UTC

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=syncsphere
MYSQL_USER=syncsphere
MYSQL_PASSWORD=replace-with-local-mysql-app-password
MYSQL_PORT=3306

# MongoDB
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=replace-with-local-root-password
MONGODB_DATABASE=syncsphere
MONGODB_APP_USERNAME=syncsphere
MONGODB_APP_PASSWORD=replace-with-local-mongodb-app-password
MONGODB_PORT=27017

# Redis
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379
